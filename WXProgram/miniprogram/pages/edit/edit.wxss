/* pages/edit/edit.wxss */
.edit-area {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.text-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.image-list {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  gap: 20rpx;
}

.image-item-wrapper {
  position: relative;
  width: 220rpx;
  height: 220rpx;
}

.image-item {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-icon {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
}

.add-image-btn {
  width: 220rpx;
  height: 220rpx;
  background-color: #f7f7f7;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #999999;
}

.bottom-bar {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.save-btn {
  width: 100%;
}