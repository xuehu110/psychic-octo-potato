/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 20rpx;
}

/* 通用文本样式 */
.text-primary {
  color: #1296db;
}

.text-secondary {
  color: #666666;
}

.text-gray {
  color: #999999;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #1296db;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
}

.btn-default {
  background-color: #f7f7f7;
  color: #333333;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
}

/* 通用卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 通用列表样式 */
.list-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 通用图片样式 */
.image-preview {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

/* 通用间距 */
.margin-top {
  margin-top: 20rpx;
}

.margin-bottom {
  margin-bottom: 20rpx;
}

.padding {
  padding: 20rpx;
}

/* 通用flex布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}